# Ambiente de execução: development | test | production
NODE_ENV=development

PORT=3000

DATABASE_URL=postgresql://user:password@127.0.0.1:5432/postgres

# Schema Postgres dedicado do Gateway (só [a-z0-9_], começa com letra ou _)
DB_SCHEMA=gateway

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ey...

MAX_SYNC_ITEMS=10000

BODY_LIMIT=5mb

# Provedor de autenticação: omitir = Supabase JWKS real | 'fake' = FakeAuthProvider (desenvolvimento/testes)
# AUTH_PROVIDER=fake

# Seed (opcionais, usados por bun run db:seed)
# SENTINEL_COMPANY_NAME=Sentience
# SENTINEL_COMPANY_CNPJ=00000000000191
# SENTINEL_COMPANY_DOMAIN=sentience.internal
# SUPER_ADMIN_NAME="Super Admin Sentience"
# SUPER_ADMIN_EMAIL=admin@sentience.internal
# SUPER_ADMIN_PASSWORD=SentienceAdmin123!
# SUPER_ADMIN_CPF=52998224725

